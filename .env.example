# 咕咕数据 API 密钥（可选）
# 留空则使用 Demo 演示接口，适合本地开发体验
# 正式数据：https://www.gugudata.com/portal/
VITE_GUGUDATA_APPKEY=

# 查询录取年份（2026 为当前默认）
VITE_GAOKAO_YEAR=2026

# API 代理前缀（一般不用改）
# 本地开发 / Vercel 部署均使用此路径，由代理转发到 api.gugudata.com
VITE_API_BASE=/api/gugudata

# ── Vercel 部署说明 ──
# 1. 把项目推到 GitHub，或在 vercel.com 导入本地文件夹
# 2. Vercel 项目 Settings → Environment Variables 可添加：
#    VITE_GUGUDATA_APPKEY = 你的咕咕数据密钥（可选，留空则用本地演示数据）
#    VITE_GAOKAO_YEAR = 2026
# 3. 部署完成后会得到 https://xxx.vercel.app 公网地址
